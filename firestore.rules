rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- perfil y roles ----------
    // El rol vive en usuarios/{uid}. Nadie puede escribir su propio rol.

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function logueado() {
      return request.auth != null;
    }

    function activo() {
      return logueado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfil().activo == true;
    }

    function esAdmin() {
      return activo() && perfil().rol == 'admin';
    }

    function esCajero() {
      return activo() && perfil().rol == 'cajero';
    }

    function staff() {
      return esAdmin() || esCajero();
    }

    // ---------- utilidades ----------

    function num(campo) {
      return request.resource.data[campo] is number;
    }

    function texto(campo, largo) {
      return request.resource.data[campo] is string
        && request.resource.data[campo].size() > 0
        && request.resource.data[campo].size() <= largo;
    }

    function sinCambiar(campos) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(campos);
    }

    // Marca de quien hizo el movimiento: debe coincidir con quien esta logueado.
    function autoria() {
      return request.resource.data.uid == request.auth.uid;
    }

    // ================= instalacion =================
    // Documento centinela. Mientras no exista, la plataforma permite crear un
    // unico administrador desde el asistente de primer arranque. Una vez creado
    // no se puede modificar ni borrar, asi que la puerta queda cerrada.

    function sinInstalar() {
      return !exists(/databases/$(database)/documents/config/instalacion);
    }

    // El mismo lote de escritura debe dejar creado el centinela.
    function cierraInstalacion() {
      return getAfter(/databases/$(database)/documents/config/instalacion).data.completada == true;
    }

    match /config/instalacion {
      // Se consulta antes de iniciar sesion para saber si falta instalar.
      allow get: if true;
      allow create: if logueado() && sinInstalar();
      allow update, delete: if false;
    }

    // ================= usuarios del sistema =================
    // Despues del primer arranque, solo un admin crea o edita usuarios.

    match /usuarios/{uid} {
      allow get: if logueado() && (request.auth.uid == uid || esAdmin());
      allow list: if esAdmin();

      allow create: if (
          esAdmin()
          || (
            // Primer administrador: se crea a si mismo y cierra la instalacion.
            request.auth.uid == uid
            && sinInstalar()
            && cierraInstalacion()
            && request.resource.data.rol == 'admin'
          )
        )
        && texto('nombre', 120)
        && request.resource.data.rol in ['admin', 'cajero']
        && request.resource.data.activo is bool;

      // Un admin no puede cambiarse a si mismo el rol ni desactivarse.
      allow update: if esAdmin()
        && request.resource.data.rol in ['admin', 'cajero']
        && (request.auth.uid != uid || sinCambiar(['rol', 'activo']));

      allow delete: if false;
    }

    // ================= configuracion =================

    match /config/{doc} {
      allow read: if staff();
      allow write: if esAdmin() && doc != 'instalacion';
    }

    // ================= categorias =================

    match /categorias/{id} {
      allow read: if staff();
      allow create, update: if staff()
        && texto('nombre', 80)
        && request.resource.data.tipo in ['bebida', 'snack', 'comida'];
      allow delete: if esAdmin();
    }

    // ================= productos y precios =================
    // Cajero y admin manejan catalogo, precios e inventario.
    // El stock nunca puede quedar negativo desde el cliente.

    match /productos/{id} {
      allow read: if staff();

      allow create: if staff()
        && texto('nombre', 120)
        && num('precio') && request.resource.data.precio >= 0
        && num('costo') && request.resource.data.costo >= 0
        && request.resource.data.controlaStock is bool
        && num('stock') && request.resource.data.stock >= 0;

      allow update: if staff()
        && num('precio') && request.resource.data.precio >= 0
        && num('costo') && request.resource.data.costo >= 0
        && num('stock') && request.resource.data.stock >= 0;

      // Los productos no se borran, se marcan inactivos para no romper el historial.
      allow delete: if false;
    }

    // ================= trabajadores con credito =================
    // Regla clave: el saldo no puede pasar del limite autorizado.
    // limite en 0 significa sin limite.

    match /trabajadores/{id} {
      allow read: if staff();

      allow create: if staff()
        && texto('codigo', 30)
        && texto('nombre', 120)
        && num('limite') && request.resource.data.limite >= 0
        && num('saldo') && request.resource.data.saldo == 0
        && request.resource.data.activo is bool;

      allow update: if staff()
        && num('saldo')
        && request.resource.data.saldo >= 0
        && num('limite') && request.resource.data.limite >= 0
        && (
          request.resource.data.limite == 0
          || request.resource.data.saldo <= request.resource.data.limite
        );

      allow delete: if false;
    }

    // ================= ventas =================
    // Se crean desde la caja. Nadie las edita ni las borra:
    // corregir una venta es anularla, y anular es tarea del admin.

    match /ventas/{id} {
      allow read: if staff();

      allow create: if staff()
        && autoria()
        && request.resource.data.metodo in ['efectivo', 'credito']
        && request.resource.data.estado == 'completada'
        && num('total') && request.resource.data.total > 0
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 60
        && (
          request.resource.data.metodo == 'efectivo'
            || request.resource.data.trabajadorId is string
        );

      // Unica edicion permitida: anular, y solo el admin.
      allow update: if esAdmin()
        && resource.data.estado == 'completada'
        && request.resource.data.estado == 'anulada'
        && sinCambiar(['items', 'total', 'metodo', 'trabajadorId', 'uid', 'fecha']);

      allow delete: if false;
    }

    // ================= movimientos de cuenta =================
    // Libro de cargos, abonos y descuentos. Solo se agrega, nunca se corrige:
    // un error se arregla con otro movimiento en contra.

    match /movimientos_cuenta/{id} {
      allow read: if staff();

      allow create: if staff()
        && autoria()
        && request.resource.data.tipo in ['cargo', 'abono', 'descuento', 'ajuste']
        && num('monto')
        && request.resource.data.trabajadorId is string
        && (request.resource.data.tipo != 'ajuste' || esAdmin());

      allow update, delete: if false;
    }

    // ================= movimientos de inventario =================

    match /movimientos_stock/{id} {
      allow read: if staff();

      allow create: if staff()
        && autoria()
        && request.resource.data.tipo in ['entrada', 'salida', 'ajuste', 'venta', 'devolucion']
        && num('cantidad')
        && request.resource.data.productoId is string;

      allow update, delete: if false;
    }

    // ================= periodos de planilla =================

    match /periodos/{id} {
      allow read: if staff();

      allow create: if esAdmin()
        && texto('nombre', 80)
        && request.resource.data.estado == 'abierto';

      // Solo se cierra, no se reabre.
      allow update: if esAdmin()
        && resource.data.estado == 'abierto'
        && sinCambiar(['inicio', 'fin']);

      allow delete: if false;
    }

    // ================= bitacora =================

    match /bitacora/{id} {
      allow read: if esAdmin();
      allow create: if staff() && autoria();
      allow update, delete: if false;
    }

    // Todo lo que no este declarado arriba queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
